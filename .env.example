# ============ Backend (FastAPI) ============
GEMINI_API_KEY=isi_dengan_api_key_gemini
GEMINI_MODEL=gemini-2.5-flash
PUBLIC_BASE_URL=https://backend.agenthebat.com
CLIP_WORK_DIR=/data/clips
CLIP_SERVER_TOKEN=
YTDLP_COOKIES=
CORS_ORIGINS=*

# ---- Auth & Database (Fase 0) ----
# Kosong = pakai SQLite di CLIP_WORK_DIR/otopost.db.
# Postgres: postgresql+psycopg2://user:pass@host:5432/otopost
DATABASE_URL=
# WAJIB diisi string acak panjang di produksi. Contoh: openssl rand -hex 32
JWT_SECRET=
# Masa berlaku token (menit). Default 7 hari.
JWT_EXPIRE_MINUTES=10080
# Kunci enkripsi API key milik user. Kosong = diturunkan dari JWT_SECRET.
CREDENTIAL_ENC_KEY=
# true = semua endpoint kerja (transcript/clips/ai) wajib login.
REQUIRE_AUTH=false
# Kredit awal untuk user paket free.
FREE_CREDITS=30

# ---- Batas kerja (hardening) ----
MAX_SEGMENTS_PER_JOB=30
MAX_CLIP_SECONDS=180
JOB_TTL_SECONDS=3600

# ============ Frontend (Next.js) ============
NEXT_PUBLIC_API_BASE=http://localhost:8000
# Wajib login untuk membuka Studio? (samakan dengan REQUIRE_AUTH backend)
NEXT_PUBLIC_REQUIRE_AUTH=false
