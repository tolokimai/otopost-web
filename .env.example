# ============ Backend (FastAPI) ============
GEMINI_API_KEY=isi_dengan_api_key_gemini
GEMINI_MODEL=gemini-2.5-flash
PUBLIC_BASE_URL=http://localhost:5000
APP_BASE_URL=http://localhost:3000
CLIP_WORK_DIR=./data/clips
YTDLP_COOKIES=
CORS_ORIGINS=http://localhost:3000

# Auth & database
DATABASE_URL=
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRE_MINUTES=10080
CREDENTIAL_ENC_KEY=
REQUIRE_AUTH=false
FREE_CREDITS=30
# Akun yang otomatis dipromosikan menjadi admin saat startup; pisahkan koma.
ADMIN_EMAILS=owner@example.com

# Runtime limits
MAX_SEGMENTS_PER_JOB=30
MAX_CLIP_SECONDS=180
JOB_TTL_SECONDS=3600
MAX_UPLOAD_MB=100

# Billing (dapat dioverride lewat Admin setelah seed)
BILLING_ENABLED=true
PAYMENT_PROVIDER=simulate
BILLING_SIMULATE_ALLOW=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# MuseTalk 1.5 GPU worker (tidak ada Wav2Lip)
MUSETALK_WORKER_URL=
MUSETALK_WORKER_TOKEN=
MUSETALK_TIMEOUT_SECONDS=1800

# ============ Frontend (Next.js; nilai di-inline saat build) ============
NEXT_PUBLIC_API_BASE=http://localhost:5000
NEXT_PUBLIC_REQUIRE_AUTH=false

# ============ MuseTalk worker (opsional, profile gpu) ============
MUSETALK_PUBLIC_BASE_URL=http://localhost:9000
MUSETALK_GPU_ID=0
MUSETALK_BATCH_SIZE=8
AUTO_DOWNLOAD_MODELS=0
