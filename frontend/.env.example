# URL backend FastAPI (tanpa trailing slash).
# Lokal:   http://localhost:8000
# Produksi: https://backend.agenthebat.com
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Wajib login untuk memakai Studio? (true/false)
# false = Studio bisa dipakai tanpa login (backend juga harus REQUIRE_AUTH=false)
NEXT_PUBLIC_REQUIRE_AUTH=false
